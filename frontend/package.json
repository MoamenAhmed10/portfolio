{
  "name": "portfolio-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "npx ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "vercel-build": "npx ng build --configuration production"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
 "dependencies": {
  "@angular/common": "21.0.7",
  "@angular/compiler": "21.0.7",
  "@angular/core": "21.0.7",
  "@angular/forms": "21.0.7",
  "@angular/platform-browser": "21.0.7",
  "@angular/platform-browser-dynamic": "21.0.7",
  "@angular/router": "21.0.7",
  "rxjs": "~7.8.0",
  "tslib": "^2.3.0"
},
  "devDependencies": {
  "@angular/build": "21.0.7",
  "@angular/cli": "21.0.7",
  "@angular/compiler-cli": "21.0.7",
  "jsdom": "^27.1.0",
  "typescript": "~5.9.2"
}
}